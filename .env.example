# Server-side contact delivery. Set all three to activate the contact form.
# Never prefix provider secrets with NEXT_PUBLIC_.
# Resend requires a verified sender domain: https://resend.com/docs/dashboard/domains/introduction
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Rate limiting in /api/contact is process-local. Use a shared store when
# scaling the app across multiple server instances.
